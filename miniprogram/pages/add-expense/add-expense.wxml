<view class="page">
  <view class="card form-card">
    <view class="field">
      <view class="field-label">支出名称</view>
      <input
        class="input"
        placeholder="例如：购买卫生纸"
        placeholder-class="placeholder"
        maxlength="80"
        value="{{title}}"
        bindinput="onTitleInput"
      />
    </view>

    <view class="field">
      <view class="field-label">金额（元）</view>
      <input
        class="input amount-input"
        type="digit"
        placeholder="0.00"
        placeholder-class="placeholder"
        value="{{amount}}"
        bindinput="onAmountInput"
      />
    </view>

    <view class="field">
      <view class="field-label">消费分类</view>
      <view class="chip-row">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="chip {{category === item ? 'chip-active' : ''}}"
          bindtap="onCategoryTap"
          data-category="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">代付人</view>
      <picker range="{{memberNames}}" value="{{payerIndex}}" bindchange="onPayerChange">
        <view class="picker-value">
          <text wx:if="{{payerName}}">{{payerName}}</text>
          <text wx:else class="placeholder">请选择代付人</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">消费日期</view>
      <picker mode="date" value="{{dateKey}}" bindchange="onDateChange">
        <view class="picker-value">
          <text>{{dateText}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <button
    class="btn-primary save-btn"
    loading="{{saving}}"
    disabled="{{saving}}"
    bindtap="handleSave"
  >
    {{id ? '保存修改' : '添加支出'}}
  </button>

  <button wx:if="{{id}}" class="btn-delete" bindtap="handleDelete">删除这笔支出</button>
</view>
