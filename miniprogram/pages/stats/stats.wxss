.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #334155;
  font-size: 44rpx;
  line-height: 66rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.month-picker {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
  padding: 12rpx 24rpx;
}

.month-caret {
  font-size: 24rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

.summary-card {
  background: linear-gradient(135deg, #0e7c6b 0%, #2ba08a 100%);
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 36rpx rgba(14, 124, 107, 0.22);
}

.summary-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.summary-amount {
  font-size: 64rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.summary-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 24rpx;
}

.donut-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.donut {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.donut-hole {
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.donut-total {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
}

.donut-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.category-row {
  margin-bottom: 24rpx;
}

.category-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.category-name {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.category-amount {
  font-size: 25rpx;
  color: #64748b;
}

.bar-track {
  height: 14rpx;
  background: #eef2f7;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  min-width: 6rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
  margin-right: 20rpx;
}

.rank-1 {
  background: #fef3c7;
  color: #b45309;
}

.rank-2 {
  background: #e2e8f0;
  color: #475569;
}

.rank-3 {
  background: #fde8d7;
  color: #c2410c;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.rank-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.personal-card {
  margin-top: 24rpx;
}

.personal-row {
  display: flex;
}

.personal-item {
  flex: 1;
  text-align: center;
}

.personal-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
}

.personal-label {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #94a3b8;
}

.balance-receive {
  color: #0e7c6b;
}

.balance-pay {
  color: #d9534f;
}

.empty-card {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.empty-btn {
  margin: 30rpx auto 0;
  width: 240rpx;
  padding: 20rpx 0;
  border-radius: 18rpx;
  background: #0e7c6b;
  color: #ffffff;
  font-size: 28rpx;
}
