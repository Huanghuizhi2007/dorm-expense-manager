.auth-page {
  min-height: 100vh;
  padding: 48rpx 48rpx 60rpx;
  background: #f6f7f9;
}

.page-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #111827;
}

.page-sub {
  margin-top: 14rpx;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  color: #64748b;
}

.auth-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.placeholder {
  color: #94a3b8;
}

.register-btn {
  margin-top: 8rpx;
}

.login-link {
  margin-top: 40rpx;
  text-align: center;
  font-size: 27rpx;
  color: #64748b;
}

.login-link text {
  color: #0e7c6b;
  font-weight: 700;
}
