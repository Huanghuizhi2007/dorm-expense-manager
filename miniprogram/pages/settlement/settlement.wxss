.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #334155;
  font-size: 44rpx;
  line-height: 66rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.month-picker {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
  padding: 12rpx 24rpx;
}

.month-caret {
  font-size: 24rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

.generate-btn {
  margin-bottom: 24rpx;
}

.total-card {
  background: linear-gradient(135deg, #0e7c6b 0%, #2ba08a 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(14, 124, 107, 0.22);
}

.total-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.total-amount {
  font-size: 64rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.total-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 20rpx;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.entry-row:last-child {
  border-bottom: none;
}

.entry-main {
  display: flex;
  align-items: center;
}

.entry-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e6f4f0;
  color: #0e7c6b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
  margin-right: 18rpx;
}

.entry-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #111827;
}

.entry-numbers {
  text-align: right;
}

.entry-line {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.entry-line:first-child {
  margin-top: 0;
}

.entry-line text {
  font-weight: 700;
  color: #1f2937;
}

.balance-receive {
  color: #0e7c6b;
}

.balance-pay {
  color: #d9534f;
}

.transfer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

.transfer-people {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.transfer-arrow {
  color: #94a3b8;
  margin: 0 10rpx;
}

.transfer-amount {
  font-size: 28rpx;
  font-weight: 800;
  color: #0e7c6b;
}

.transfer-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.empty-btn {
  margin: 30rpx auto 0;
  width: 240rpx;
  padding: 20rpx 0;
  border-radius: 18rpx;
  background: #0e7c6b;
  color: #ffffff;
  font-size: 28rpx;
}
