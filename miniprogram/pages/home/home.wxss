.home-page {
  padding-bottom: 200rpx;
}

.hero-card {
  background: linear-gradient(135deg, #0e7c6b 0%, #11897a 55%, #2ba08a 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  color: #ffffff;
  margin-bottom: 30rpx;
  box-shadow: 0 14rpx 36rpx rgba(14, 124, 107, 0.24);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.82;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.invite-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.invite-code {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
}

.copy-text {
  font-size: 22rpx;
  margin-left: 14rpx;
  text-decoration: underline;
  opacity: 0.9;
}

.member-pill {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}

.hero-amount-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 30rpx;
}

.hero-amount {
  font-size: 64rpx;
  font-weight: 800;
  margin-top: 6rpx;
}

.hero-count {
  font-size: 24rpx;
  opacity: 0.85;
  padding-bottom: 10rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.section-count {
  font-size: 24rpx;
  color: #94a3b8;
}

.section-links {
  display: flex;
  align-items: center;
}

.section-link {
  font-size: 24rpx;
  color: #0e7c6b;
  font-weight: 600;
  margin-right: 18rpx;
}

.expense-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-hover {
  opacity: 0.82;
  transform: scale(0.99);
}

.expense-main {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  margin-bottom: 10rpx;
}

.expense-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  word-break: break-all;
}

.expense-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.expense-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx dashed #cbd5e1;
  color: #94a3b8;
  font-size: 48rpx;
  line-height: 80rpx;
  margin: 0 auto 20rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.loading-more {
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.empty-dorm {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-dorm-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: #e6f4f0;
  color: #0e7c6b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 120rpx;
  margin: 0 auto 28rpx;
}

.empty-dorm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.empty-dorm-sub {
  margin-top: 12rpx;
  margin-bottom: 36rpx;
  font-size: 26rpx;
  color: #64748b;
}

.dorm-action {
  width: 80%;
  margin: 0 auto;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 48rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #0e7c6b;
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 500;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(14, 124, 107, 0.36);
  z-index: 20;
}

.fab-hover {
  transform: scale(0.94);
  opacity: 0.9;
}
