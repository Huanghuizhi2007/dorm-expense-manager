.dorm-list {
  margin-bottom: 28rpx;
}

.dorm-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dorm-active {
  border: 3rpx solid rgba(14, 124, 107, 0.55);
}

.dorm-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.dorm-code {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.dorm-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #0e7c6b;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 52rpx;
  text-align: center;
}

.segmented {
  display: flex;
  background: #e8edf3;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.segment {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-weight: 600;
}

.segment-active {
  background: #ffffff;
  color: #0e7c6b;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
}

.field-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.placeholder {
  color: #94a3b8;
}

.action-btn {
  margin-top: 28rpx;
}

.hint {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: #94a3b8;
  text-align: center;
}

.danger-zone {
  border: 2rpx solid #fde2e1;
  background: #fffafa;
}

.danger-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #b91c1c;
}

.danger-sub {
  margin-top: 10rpx;
  margin-bottom: 22rpx;
  font-size: 24rpx;
  color: #9f7f7f;
}

.btn-danger {
  background: #ffffff;
  color: #d9534f;
  border: 2rpx solid rgba(217, 83, 79, 0.45);
  border-radius: 18rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
}

.btn-danger::after {
  border: none;
}
